{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Windows Core Ecosystem",
            "dependsOn": [
                "Run Windows Setup",
                "Open Windows Postman",
                "Open Core Storybook",
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Run Windows Setup",
            "type": "shell",
            "command": "gsudo.exe",
            "args": [
                "pwsh",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/setup.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Open Windows Postman",
            "type": "shell",
            "command": "&",
            "args": [
                "\"${env:LOCALAPPDATA}\\Postman\\Postman.exe\""
            ],
            "group": "build",
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Open Core Storybook Preview",
            "type": "shell",
            "command": "start",
            "args": [
                "msedge",
                "http://localhost:3690"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Close Core Storybook Preview",
            "type": "shell",
            "command": "echo ${input:closeCoreStorybookPreview}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run Core Background Storybook",
            "type": "npm",
            "script": "storybook",
            "path": "prototype/web/core",
            "isBackground": true,
            "promptOnClose": true,
            "problemMatcher": [
                {
                    "owner": "custom",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Storybook.*",
                        "endsPattern": ".*(Local:\\s*http://localhost:3690|http://localhost:3690).*"
                    }
                }
            ]
        },
        {
            "label": "Stop Core Background Storybook",
            "type": "shell",
            "command": "echo ${input:stopCoreBackgroundStorybook}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Open Core Storybook",
            "dependsOn": [
                "Run Core Background Storybook",
                "Open Core Storybook Preview"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Close Core Storybook",
            "dependsOn": [
                "Close Core Storybook Preview",
                "Stop Core Background Storybook"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Start Windows Prototype Core Images File Service",
            "type": "shell",
            "command": "caddy.exe",
            "args": [
                "run",
                "--config",
                "Caddyfile"
            ],
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/services/core/images-file-service/caddy",
                "env": {
                    "IMAGE_ASSETS_DIRECTORY_PATH": "${workspaceFolder}/prototype/web/core/public/assets/images"
                }
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [
                {
                    "owner": "caddy",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*starting.*",
                        "endsPattern": ".*(serving|started|listening).*"
                    }
                }
            ]
        },
        {
            "label": "Stop Windows Prototype Core Images File Service",
            "type": "shell",
            "command": "echo ${input:stopWindowsPrototypeCoreImagesFileService}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Start Windows Prototype Core Products Data Service",
            "type": "shell",
            "command": "go",
            "args": [
                "run",
                "main.go"
            ],
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/services/core/products-data-service/fiber-go",
                "env": {
                    "PRODUCTS_CACHE_PATH": "${workspaceFolder}/services/core/products-data-service/fiber-go/data/products-cache.db"
                }
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": false,
                "panel": "dedicated"
            },
            "dependsOn": "Build Windows Prototype Core Products Data Service",
            "problemMatcher": [
                {
                    "owner": "go",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/services/core/products-data-service/fiber-go"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*(starting|Starting|running|Running).*",
                        "endsPattern": ".*(listening|Listening|ready|Ready|started|Started|server.*running|Server.*running|:4979).*"
                    }
                }
            ]
        },
        {
            "label": "Stop Windows Prototype Core Products Data Service",
            "type": "shell",
            "command": "echo ${input:stopWindowsPrototypeCoreProductsDataService}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build Windows Prototype Core Products Data Service",
            "type": "shell",
            "command": "go",
            "args": [
                "build",
                "./..."
            ],
            "options": {
                "cwd": "${workspaceFolder}/services/core/products-data-service/fiber-go"
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": false,
                "panel": "dedicated"
            },
            "dependsOn": "Update Windows Prototype Core Products Data Service Modules",
            "group": "build",
            "problemMatcher": [
                {
                    "owner": "go",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/services/core/products-data-service/fiber-go"
                    ],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "Update Windows Prototype Core Products Data Service Modules",
            "type": "shell",
            "command": "go",
            "args": [
                "mod",
                "tidy"
            ],
            "options": {
                "cwd": "${workspaceFolder}/services/core/products-data-service/fiber-go"
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": false,
                "panel": "dedicated"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start Windows Prototype Core Products Component Service",
            "type": "npm",
            "script": "dev",
            "path": "services/core/products-component-service/nextjs",
            "isBackground": true,
            "options": {
                "env": {
                    "PRODUCT_DATA_SERVICE_ADDRESS": "http://localhost:4979",
                    "IMAGES_FILE_SERVICE_ADDRESS": "http://localhost:5173"
                }
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [
                {
                    "owner": "nextjs",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}/services/core/products-component-service/nextjs"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*starting.*",
                        "endsPattern": ".*(Local:\\s*http://localhost:6039|Ready in)"
                    }
                }
            ]
        },
        {
            "label": "Stop Windows Prototype Core Products Component Service",
            "type": "shell",
            "command": "echo ${input:stopWindowsPrototypeCoreProductsComponentService}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Start Windows Prototype Core Prototype Service",
            "type": "shell",
            "command": "caddy.exe",
            "args": [
                "run",
                "--config",
                "Caddyfile"
            ],
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/services/core/prototype-service/caddy"
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [
                {
                    "owner": "caddy",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*starting.*",
                        "endsPattern": ".*(serving|started|listening).*"
                    }
                }
            ]
        },
        {
            "label": "Stop Windows Prototype Core Prototype Service",
            "type": "shell",
            "command": "echo ${input:stopWindowsPrototypeCorePrototypeService}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Start All Windows Core Services",
            "dependsOn": [
                "Run Core Background Storybook",
                "Start Windows Prototype Core Images File Service",
                "Start Windows Prototype Core Products Data Service",
                "Start Windows Prototype Core Products Component Service",
                "Start Windows Prototype Core Prototype Service"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "Stop All Windows Core Services",
            "dependsOn": [
                "Stop Windows Prototype Core Prototype Service",
                "Stop Windows Prototype Core Products Component Service",
                "Stop Windows Prototype Core Products Data Service",
                "Stop Windows Prototype Core Images File Service",
                "Stop Core Background Storybook"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "openCoreStorybookPreview",
            "type": "command",
            "command": "workbench.action.debug.start"
        },
        {
            "id": "closeCoreStorybookPreview",
            "type": "command",
            "command": "workbench.action.debug.stop"
        },
        {
            "id": "stopCoreBackgroundStorybook",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Run Core Background Storybook"
        },
        {
            "id": "stopWindowsPrototypeCoreImagesFileService",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Start Windows Prototype Core Images File Service"
        },
        {
            "id": "stopWindowsPrototypeCoreProductsDataService",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Start Windows Prototype Core Products Data Service"
        },
        {
            "id": "stopWindowsPrototypeCoreProductsComponentService",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Start Windows Prototype Core Products Component Service"
        },
        {
            "id": "stopWindowsPrototypeCorePrototypeService",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Start Windows Prototype Core Prototype Service"
        }
    ]
}
