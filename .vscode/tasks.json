{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Storybook Preview",
            "type": "shell",
            "command": "echo ${input:openStorybookPreview}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Background Storybook",
            "type": "npm",
            "script": "storybook",
            "path": "prototype/web/core",
            "isBackground": true,
            "promptOnClose": true,
            "problemMatcher": [
                {
                    "owner": "custom",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Storybook.*",
                        "endsPattern": ".*(Local:\\s*http://localhost:3690|http://localhost:3690).*"
                    }
                }
            ]
        },
        {
            "label": "Open Storybook",
            "dependsOn": [
                "Background Storybook",
                "Storybook Preview"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Terminate Background Storybook",
            "type": "shell",
            "command": "echo ${input:terminateBackgroundStorybook}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Close Storybook Preview",
            "type": "shell",
            "command": "echo ${input:closeStorybookPreview}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Close Storybook",
            "dependsOn": [
                "Close Storybook Preview",
                "Terminate Background Storybook"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Background Production Website",
            "type": "shell",
            "command": "npx http-server public -p 9630",
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "custom",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Starting up http-server.*",
                        "endsPattern": ".*Available on:.*"
                    }
                }
            ]
        },
        {
            "label": "Production Website Preview",
            "type": "shell",
            "command": "echo ${input:openProductionWebsitePreview}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Open Production Website",
            "dependsOn": [
                "Background Production Website",
                "Production Website Preview"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Terminate Background Production Website",
            "type": "shell",
            "command": "echo ${input:terminateBackgroundProductionWebsite}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Close Production Website",
            "dependsOn": [
                "Close Storybook Preview",
                "Terminate Background Production Website"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Open Windows Postman",
            "type": "shell",
            "command": "&",
            "args": [
                "\"${env:LOCALAPPDATA}\\Postman\\Postman.exe\""
            ],
            "group": "build",
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Windows Setup",
            "type": "shell",
            "command": "gsudo.exe",
            "args": [
                "pwsh",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/setup.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Windows Sarikanto Test Image File Service",
            "type": "shell",
            "command": "caddy.exe",
            "args": [
                "run",
                "--config",
                "Caddyfile"
            ],
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/services/sarikanto/image-file-service/caddy",
                "env": {
                    "IMAGE_ASSETS_DIRECTORY_PATH": "${workspaceFolder}/prototype/web/sarikanto/public/assets/images"
                }
            },
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Windows Test Sarikanto Image File Service",
            "type": "shell",
            "command": "echo ${input:terminateWindowsSarikantoTestImageFileService}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "openStorybookPreview",
            "type": "command",
            "command": "workbench.action.debug.start"
        },
        {
            "id": "openProductionWebsitePreview",
            "type": "command",
            "command": "workbench.action.debug.start"
        },
        {
            "id": "terminateBackgroundStorybook",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Background Storybook"
        },
        {
            "id": "terminateBackgroundProductionWebsite",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Background Production Website"
        },
        {
            "id": "closeStorybookPreview",
            "type": "command",
            "command": "workbench.action.debug.stop"
        },
        {
            "id": "terminateWindowsSarikantoTestImageFileService",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Start Windows Sarikanto Test Image File Service"
        }
    ]
}
