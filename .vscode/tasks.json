{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Windows Core Ecosystem",
            "dependsOn": [
                "Run Windows Setup",
                "Open Windows Postman",
                "Open Core Storybook",
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Run Windows Setup",
            "type": "shell",
            "command": "gsudo.exe",
            "args": [
                "pwsh",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/setup.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "echo": true,
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Open Windows Postman",
            "type": "shell",
            "command": "&",
            "args": [
                "\"${env:LOCALAPPDATA}\\Postman\\Postman.exe\""
            ],
            "group": "build",
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Open Core Storybook Preview",
            "type": "shell",
            "command": "echo ${input:openCoreStorybookPreview}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Close Core Storybook Preview",
            "type": "shell",
            "command": "echo ${input:closeCoreStorybookPreview}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run Core Background Storybook",
            "type": "npm",
            "script": "storybook",
            "path": "prototype/web/core",
            "isBackground": true,
            "promptOnClose": true,
            "problemMatcher": [
                {
                    "owner": "custom",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*)$",
                        "file": 1,
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Storybook.*",
                        "endsPattern": ".*(Local:\\s*http://localhost:3690|http://localhost:3690).*"
                    }
                }
            ]
        },
        {
            "label": "Stop Core Background Storybook",
            "type": "shell",
            "command": "echo ${input:stopCoreBackgroundStorybook}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Open Core Storybook",
            "dependsOn": [
                "Run Core Background Storybook",
                "Open Core Storybook Preview"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Close Core Storybook",
            "dependsOn": [
                "Close Core Storybook Preview",
                "Stop Core Background Storybook"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Start Windows Sarikanto Test Image File Service",
            "type": "shell",
            "command": "caddy.exe",
            "args": [
                "run",
                "--config",
                "Caddyfile"
            ],
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/services/sarikanto/image-file-service/caddy",
                "env": {
                    "IMAGE_ASSETS_DIRECTORY_PATH": "${workspaceFolder}/prototype/web/sarikanto/public/assets/images"
                }
            },
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Windows Test Sarikanto Image File Service",
            "type": "shell",
            "command": "echo ${input:terminateWindowsSarikantoTestImageFileService}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "focus": false,
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "openCoreStorybookPreview",
            "type": "command",
            "command": "workbench.action.debug.start"
        },
        {
            "id": "closeCoreStorybookPreview",
            "type": "command",
            "command": "workbench.action.debug.stop"
        },
        {
            "id": "stopCoreBackgroundStorybook",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Run Core Background Storybook"
        },
        {
            "id": "terminateWindowsSarikantoTestImageFileService",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Start Windows Sarikanto Test Image File Service"
        }
    ]
}
