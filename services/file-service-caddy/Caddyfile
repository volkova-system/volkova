{
    # Disable automatic HTTPS for local development
    auto_https off

    # Local admin API
    admin localhost:2019

    # Optional: Basic logging
    log {
        output file logs/access.log
        format console
    }
}

localhost:5003 {
    handle /test/assets/images/* {
        root * C:\path\to\your\assets
        rewrite /assets/images/* /{path}
        file_server
    }

    handle {
        respond "Local Development Server" 200
    }
}
